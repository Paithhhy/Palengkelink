DATABASE_URL="postgresql://palengkelink_app:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET="put-a-long-random-string-here"
PORT=3000
APP_URL="http://localhost:3000"
# PayMongo (use test keys first)
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxx"
PAYMONGO_WEBHOOK_SECRET="whsk_xxxxxxxx"
PAYMONGO_METHODS="gcash,card"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PalengkeLink <your.address@gmail.com>"
# Testing only: send EVERY email to this one address instead of the real person (leave empty for normal use).
MAIL_ONLY_TO=""
# Mailtrap SDK (used instead of SMTP when MAILTRAP_TOKEN is set). Token: Mailtrap > Settings > API Tokens.
# No domain yet? MAIL_FROM="Mailtrap Test <hello@demomailtrap.co>" only delivers to your own Mailtrap account email.
# MAILTRAP_INBOX_ID set = Sandbox (test inbox, nobody really receives it); empty = Email Sending (real emails, MAIL_FROM must use your verified domain).
MAILTRAP_TOKEN=""
MAILTRAP_INBOX_ID=""
