# Copy this file to .env (never commit .env). On Vercel, add the same names under Settings > Environment Variables.
# Neon POOLED string, logging in as the limited user palengkelink_app (NOT the owner / admin).
DATABASE_URL="postgresql://palengkelink_app:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET="put-a-long-random-string-here"
PORT=3000
APP_URL="http://localhost:3000"
# PayMongo (use test keys first)
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxx"
PAYMONGO_WEBHOOK_SECRET="whsk_xxxxxxxx"
PAYMONGO_METHODS="gcash,card"
# Email for "Forgot password" (optional on your computer: without SMTP_HOST the email is printed in the terminal).
# Gmail: turn on 2-Step Verification, create an App Password, then use smtp.gmail.com / 587 / your address / the app password.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PalengkeLink <your.address@gmail.com>"
