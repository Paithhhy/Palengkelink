{
  "name": "palengkelink-api",
  "version": "1.0.0",
  "description": "PalengkeLink - Public Market Vendor, Stall and Supply Management API (Express + Prisma + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
